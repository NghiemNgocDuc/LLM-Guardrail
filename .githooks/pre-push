#!/bin/sh
# Block git push when agent skills under .cursor/skills/ contain leaks or destructive commands.
# The canonical Python scanner decides whether a push is permitted. Optional
# standalone binaries cannot replace its current security checks.
set -e

ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

PYTHON="${PYTHON:-}"
if [ -z "$PYTHON" ]; then
  for candidate in "$ROOT/.venv/bin/python" "$ROOT/.venv/Scripts/python.exe" "$ROOT/venv312/Scripts/python.exe" python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      PYTHON="$candidate"
      break
    fi
  done
fi
if [ -z "$PYTHON" ] || ! command -v "$PYTHON" >/dev/null 2>&1; then
  echo "Skill Guard: Python is required to verify outgoing skills. Set PYTHON to the installed interpreter." >&2
  exit 1
fi

echo "Skill Guard: checking outgoing agent skills with the canonical scanner..."
exec "$PYTHON" scripts/scan_agent_skills.py --pre-push
