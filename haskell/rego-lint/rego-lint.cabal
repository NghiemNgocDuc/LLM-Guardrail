cabal-version:      2.4
name:               rego-lint
version:            0.1.0.0
synopsis:           Offline Rego syntax linter for OPA custom guardrail rules
description:        Static lexer/parser lint for the Rego subset used by
                    OrgPolicy.custom_rule_rego. Catches syntax errors and
                    common rule-shape mistakes before the OPA sidecar round
                    trip. Zero runtime dependencies (base only).
license:            MIT
build-type:         Simple

library
  exposed-modules:    RegoLint
  hs-source-dirs:     src
  build-depends:      base >=4.14 && <5
  default-language:   Haskell2010

executable rego-lint
  main-is:            Main.hs
  hs-source-dirs:     app
  build-depends:      base, rego-lint
  default-language:   Haskell2010

test-suite rego-lint-test
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  hs-source-dirs:     test
  build-depends:      base, rego-lint, hspec >= 2.10
  default-language:   Haskell2010