APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:8080

DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=guardrails

SECRET_KEY=

# Error tracking (optional — set your Sentry DSN)
SENTRY_DSN=

# Product analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ProductBridge (product announcements, changelogs, NPS)
PRODUCTBRIDGE_API_KEY=

# Vector store — semantic guardrail + conversation memory
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=guardrails

# Auth via Clerk (https://clerk.com) — handles signup, login, sessions, email verification
CLERK_SECRET_KEY=
# Clerk JWKS URL: https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Clerk webhook signing secret (from Clerk Dashboard → Webhooks)
CLERK_WEBHOOK_SECRET=
# PEM public key for networkless JWT verification (no JWKS fetch on every request).
# Set this to eliminate the last network call from the auth path.
# Find it in Clerk Dashboard → API Keys → Show JWT public key → PEM Public Key.
# Store on a single line with literal \n for newlines:
#   CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----
CLERK_JWT_KEY=

# Fallback SMTP for billing emails (only used if Clerk is not configured)
PUBLIC_APP_URL=http://localhost:8080
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Or use Resend for billing emails
# RESEND_API_KEY=re_...
# RESEND_FROM=noreply@llm-guardrails.dev

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Self-hosted Ollama (recommended — data never leaves your server)
# Point this at your Oracle Cloud VM: http://<oracle-vm-ip>:11434
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

DEFAULT_LLM_BACKEND=ollama
DEFAULT_MODEL=phi3

DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_RATE_LIMIT_RPD=1000
RATE_LIMIT_REDIS_URL=

DEMO_MODE=false
DEMO_DISABLE_SIGNUPS=false
DEMO_RATE_LIMIT_RPM=5
DEMO_RATE_LIMIT_RPD=25
DEMO_IP_RATE_LIMIT_RPM=20
DEMO_IP_RATE_LIMIT_RPD=100
DEMO_MAX_PROMPT_CHARS=2000
DEMO_MAX_OUTPUT_TOKENS=2048

# ────────────────────────────────────────────────────────────────────────────
# PRODUCTION HARDENING CHECKLIST
# ────────────────────────────────────────────────────────────────────────────
# 1. SECRET_KEY >= 32 chars, unique, never committed
# 2. POSTGRES_PASSWORD — strong random string
# 3. CLERK_SECRET_KEY — set this; Clerk handles auth rate-limiting + MFA
# 4. REDIS_PASSWORD — set in environment (docker-compose reads it)
# 5. ALLOWED_ORIGINS — restrict to your actual domain
# 6. Set up Let's Encrypt + uncomment HTTPS redirect in nginx.conf
# 7. Run: bash scripts/security-audit.sh
# 8. Set up automated backups: crontab or systemd timer for scripts/backup.sh
# ────────────────────────────────────────────────────────────────────────────

# Token billing (gateway usage)
BILLING_ENABLED=true
FREE_SIGNUP_TOKENS=10000
BILLING_UNLIMITED_EMAILS=dnghiem@umass.edu
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use Stripe Price IDs instead of inline checkout amounts
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_ENTERPRISE=
