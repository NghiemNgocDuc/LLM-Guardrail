# Copy to .env.private. This deployment does not read the regular .env file.
# Only a hostname here: no https:// prefix, path, or port.
PRIVATE_HOSTNAME=

# Generate three different 64-character hex values, one per field.
# Example on Linux: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Hex avoids URL-escaping problems for database and Redis passwords.
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Small CPU starter model. Changes require a new setup download and restart.
DEFAULT_MODEL=qwen3:1.7b

# PRIVATE_MODE=true and VITE_PRIVATE_MODE=true are enforced by the compose file.
# Hosted AI providers, cloud fallbacks, telemetry, email/auth providers, and
# payments are absent. Raw blocked content is omitted from audit storage.
